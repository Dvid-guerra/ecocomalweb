# Copia este archivo como `.env.local` para desarrollo, y define las mismas
# variables en el panel de Hostinger para producción.
# `.env.local` NUNCA se sube al repositorio: contiene la contraseña del correo.

# --- Dominio ---------------------------------------------------------------
# Dominio final del sitio, sin barra al final. Lo usan el sitemap, robots.txt
# y las etiquetas canónicas.
NEXT_PUBLIC_SITE_URL=https://ecocomal.com

# --- Correo del formulario de contacto --------------------------------------
# Servidor SMTP. Para una cuenta de correo alojada en Hostinger estos son los
# valores por defecto; no hace falta cambiarlos.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Cuenta de correo creada en hPanel (Correos → Cuentas de correo).
# Es la dirección desde la que salen los avisos, y debe ser del propio dominio:
# el servidor rechaza enviar en nombre de cualquier otra.
SMTP_USER=no-responder@ecocomal.com
SMTP_PASSWORD=

# Dirección que recibe las consultas. Puede ser la misma de arriba o cualquier
# otra (incluido un Gmail). Para avisar a varias personas, sepáralas por comas.
CONTACTO_DESTINO=ventas@ecocomal.com
